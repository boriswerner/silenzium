# Kopieren nach .env (wird nicht eingecheckt). Zusätzlich wird .env.local gelesen
# (Vorrang vor .env) – dort legt `npx @elevenlabs/cli onboard` den API-Key ab.
# Server-Port / Bind-Adresse
PORT=5173
HOST=127.0.0.1

# Optional: ElevenLabs Voice Changer.
# API-Key unter https://elevenlabs.io/app/settings/api-keys erzeugen
# (benötigte Rechte: Voices lesen, Models lesen, Voice Changer).
# Der Key bleibt auf dem lokalen Server und wird nie an den Browser ausgeliefert.
# Änderungen werden ohne Neustart übernommen („Erneut prüfen“ in der App).
ELEVENLABS_API_KEY=

# Optional: regionaler API-Endpunkt
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
